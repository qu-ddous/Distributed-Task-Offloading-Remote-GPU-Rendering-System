# Server Daemon Configuration (.env)

# Network Bindings
HOST=0.0.0.0
PORT=8000

# Authentication (Must match client API token for private LAN security)
API_TOKEN=supersecret-render-token-change-me

# Storage paths (Relative to server or absolute)
STORAGE_DIR=storage/jobs

# Maximum accepted upload size in bytes (Default: 2GB = 2147483648)
MAX_UPLOAD_SIZE=2147483648

# Maximum concurrent FFmpeg render jobs
MAX_CONCURRENT_JOBS=1

# Fallback to CPU encoding (libx264) when NVENC is unavailable
# Note: When false, NVENC failure immediately errors out with a descriptive message
ALLOW_CPU_FALLBACK=false

# Auto-cleanup retention in hours (0 to disable)
JOB_RETENTION_HOURS=24
